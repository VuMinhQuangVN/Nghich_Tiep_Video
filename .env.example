# Copy file này thành .env rồi điền key thật. KHÔNG commit .env lên git.

# Nhiều key cách nhau bằng dấu phẩy để bật round-robin key rotation
# (khi 1 key bị rate-limit/hết quota, hệ thống tự xoay sang key kế tiếp).
AGNES_API_KEYS=sk-agnes-key-1,sk-agnes-key-2,sk-agnes-key-3

AGNES_BASE_URL=https://apihub.agnes-ai.com/v1

# Centralized Agnes model configuration
AGNES_TEXT_MODEL=agnes-2.5-flash
AGNES_IMAGE_MODEL=agnes-image-2.1-flash
AGNES_VIDEO_MODEL=agnes-video-v2.0
AGNES_VIDEO_EXPERIMENTAL=false
AGNES_VIDEO_EXPERIMENTAL_MODEL=agnes-video-2.5-flash
AGNES_VIDEO_25_ENABLED=false
AGNES_VIDEO_25_MODEL=agnes-video-2.5

# Optional alternate route; leave empty unless a network/DNS/TLS reason requires it.
AGNES_ALTERNATE_BASE_URL=

# Centralized Agnes endpoint paths
AGNES_CHAT_ENDPOINT=/chat/completions
AGNES_IMAGE_ENDPOINT=/images/generations
AGNES_VIDEO_ENDPOINT=/videos
AGNES_VIDEO_POLL_ENDPOINT=/agnesapi

# Python HTTP timeout
AGNES_REQUEST_TIMEOUT_SEC=120

# Server Agnes đang FREE -> giới hạn thật là tốc độ request dồn dập, không phải
# quota. Mặc định KHÔNG chạy song song (=1) để không dồn tải lên server free.
MAX_CONCURRENT_IMAGE_REQUESTS=1
MAX_CONCURRENT_VIDEO_SUBMIT=1

# Poll trạng thái video (endpoint NHẸ) - vẫn check thường xuyên, không cần giãn cách.
POLL_INTERVAL_SEC=4
POLL_MAX_BACKOFF_SEC=60

# Cooldown (nghỉ) giữa 2 lần GENERATE ảnh/video liên tiếp trên cùng 1 key.
# Mặc định nghỉ 3 phút (180s). Nếu vẫn còn gặp lỗi/rate-limit, hệ thống TỰ
# TĂNG thêm COOLDOWN_STEP_SEC mỗi lần lỗi, tối đa COOLDOWN_MAX_SEC (15 phút).
# Khi ổn định lại (vài lần thành công liên tiếp), tự giảm dần về mức nền.
COOLDOWN_BASE_SEC=180
COOLDOWN_MAX_SEC=900
COOLDOWN_STEP_SEC=60
COOLDOWN_DECAY_AFTER_SUCCESS=3

OUTPUT_DIR=./output
CACHE_DIR=./cache
